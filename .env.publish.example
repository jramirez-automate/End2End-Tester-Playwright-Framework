# Publishing providers. Copy to .env.publish (gitignored) and fill what you use.
# Anything left as "none" is skipped, so the pipeline works partially configured.
# With no credentials at all, every publish command runs as a dry run.

# jira | github | none
PUBLISH_TRACKER=none
# confluence | none
PUBLISH_WIKI=none
# zephyr | none
PUBLISH_TEST_MANAGEMENT=none
# teams | slack | none
PUBLISH_CHAT=none

# Ticket keys this suite accepts, and the tag specs use (@ABC-123).
TICKET_PATTERN=^[A-Z][A-Z0-9]*-\d+$

# --- Jira / Confluence (same account) -----------------------------------------
JIRA_BASE_URL=https://your-tenant.atlassian.net
JIRA_EMAIL=you@example.com
# https://id.atlassian.com/manage-profile/security/api-tokens
JIRA_API_TOKEN=

CONFLUENCE_SPACE_ID=
CONFLUENCE_SPACE_KEY=
# Optional: nest the test plan under an existing page.
CONFLUENCE_PARENT_PAGE_ID=

# --- GitHub Issues (alternative tracker) --------------------------------------
# The REST API cannot upload attachments, so evidence is linked from here.
GITHUB_REPOSITORY=owner/repo
GITHUB_TOKEN=
GITHUB_ARTIFACT_URL=

# --- Test management ----------------------------------------------------------
ZEPHYR_API_URL=https://api.zephyrscale.smartbear.com/v2
ZEPHYR_API_TOKEN=
ZEPHYR_PROJECT_KEY=
ZEPHYR_FOLDER_ID=

# --- Chat ---------------------------------------------------------------------
CHAT_WEBHOOK_URL=
# Only these environments trigger a notification, and only when everything passed.
NOTIFY_ON_ENVS=prod

# Set to 1 to force a dry run even with credentials present.
PUBLISH_DRY_RUN=0
