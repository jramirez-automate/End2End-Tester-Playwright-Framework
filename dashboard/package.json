{
	"name": "e2e-dashboard",
	"version": "0.1.0",
	"private": true,
	"description": "E2E Control Room — local dashboard that spawns and monitors /e2e-ticket Claude Code pipeline runs",
	"type": "module",
	"engines": {
		"node": ">=20"
	},
	"scripts": {
		"dev": "concurrently -n server,web -c yellow,cyan \"npm run dev:server\" \"npm run dev:web\"",
		"dev:demo": "cross-env CLAUDE_BIN=mock DASHBOARD_FORCE_REUSE=1 DASHBOARD_SKIP_DOCTOR=1 concurrently -n server,web -c yellow,cyan \"npm run dev:server\" \"npm run dev:web\"",
		"dev:server": "tsx watch server/index.ts",
		"dev:web": "vite --config web/vite.config.ts",
		"build": "vite build --config web/vite.config.ts",
		"start": "tsx server/index.ts",
		"test": "vitest run",
		"typecheck": "tsc --project server/tsconfig.json --noEmit && tsc --project web/tsconfig.json --noEmit"
	},
	"dependencies": {
		"@fastify/static": "^8.0.0",
		"chokidar": "^4.0.0",
		"dompurify": "^3.4.11",
		"fastify": "^5.0.0",
		"marked": "^15.0.0",
		"react": "^19.0.0",
		"react-dom": "^19.0.0",
		"react-router-dom": "^7.0.0",
		"zustand": "^5.0.0"
	},
	"devDependencies": {
		"@tailwindcss/vite": "^4.3.2",
		"@types/node": "^22.0.0",
		"@types/react": "^19.0.0",
		"@types/react-dom": "^19.0.0",
		"@vitejs/plugin-react": "^4.3.0",
		"concurrently": "^9.0.0",
		"cross-env": "^10.1.0",
		"daisyui": "^5.6.14",
		"tailwindcss": "^4.3.2",
		"tsx": "^4.19.0",
		"typescript": "^5.6.0",
		"vite": "^6.0.0",
		"vitest": "^3.0.0"
	}
}
