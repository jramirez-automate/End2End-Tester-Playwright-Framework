{
	"extends": "../tsconfig.base.json",
	"compilerOptions": {
		"module": "ESNext",
		"moduleResolution": "bundler",
		"target": "ES2022",
		"lib": ["ES2022", "DOM", "DOM.Iterable"],
		"jsx": "react-jsx",
		"useDefineForClassFields": true,
		"noEmit": true
	},
	"include": ["./src/**/*.ts", "./src/**/*.tsx", "./vite.config.ts", "../shared/**/*.ts"]
}
