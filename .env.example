# The demo environment needs no file and no credentials.
#   npm test          → runs the sample suite against public demo apps
#
# For your own app, copy this once per environment:
#   cp .env.example .env.dev
#   cp .env.example .env.staging
#   cp .env.example .env.prod
#
# TEST_ENV selects the file: TEST_ENV=dev loads .env.dev.
# Every .env.* file except this one is gitignored.
#
# Write flows run on demo, local, dev, and staging. prod runs @smoke only.

# App under test. Include the scheme.
BASE_URL=http://localhost:3000

# Dedicated automation account. Never a personal login.
E2E_USERNAME=your-test-user@example.com
E2E_PASSWORD=your-test-password

# Where the sign-in form lives. Default is /.
# E2E_LOGIN_PATH=/

# Optional tenant / site / workspace for write tests.
# E2E_SITE_NAME=

# Set to 1 to reuse .auth/user.json and skip the sign-in step.
# E2E_REUSE_AUTH=0

# Second demo target (no login). Only used by the TodoMVC sample specs.
# TODO_APP_URL=https://demo.playwright.dev/todomvc

# ─── QA artifact evals (npm run eval) ─────────────────────────────────────────
# DeepEval checks test cases, bug reports and session debriefs against the QA
# skills' conventions. Format rules are pattern checks and always run; judgment
# checks need an LLM judge and are skipped until one is set. Put these in a
# separate gitignored file, .env.eval.
#
# EVAL_JUDGE=ollama                 # unset = pattern checks only | ollama | grok
# EVAL_JUDGE_MODEL=qwen2.5:7b       # Ollama: 7B+ (3B misjudges) | a Grok model id
# OLLAMA_BASE_URL=http://localhost:11434
# GROK_API_KEY=                     # only for EVAL_JUDGE=grok (xAI console)
