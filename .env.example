# Copy once per environment:
#   cp .env.example .env.local
#   cp .env.example .env.dev
#   cp .env.example .env.staging
#   cp .env.example .env.prod
#
# TEST_ENV selects the file: TEST_ENV=dev loads .env.dev.
# Every .env.* file except this one is gitignored.
#
# Write flows (create / edit / delete) run on local, dev, and staging.
# prod runs @smoke only. Do not point write tests at production.

# App under test. Include the scheme.
BASE_URL=http://localhost:3000

# Dedicated automation account. Never a personal login.
E2E_USERNAME=your-test-user@example.com
E2E_PASSWORD=your-test-password

# Where the sign-in form lives. Default is /.
# E2E_LOGIN_PATH=/login

# Where a signed-in session should land. Default is /.
# E2E_HOME_PATH=/

# Accessible name of a heading that proves the shell loaded.
# Leave blank to accept the first heading on the page.
# E2E_HOME_HEADING=Home

# Optional tenant / site / workspace. Required on write envs once create flows exist.
# E2E_SITE_NAME=

# Set to 1 to reuse .auth/user.json and skip login in global setup.
# E2E_REUSE_AUTH=0

# Set to 1 to skip login and save an empty session (public pages only).
# E2E_SKIP_AUTH=0
