{
	"name": "end2end-tester-playwright-framework",
	"version": "1.0.0",
	"private": true,
	"description": "End2End Tester Playwright Framework",
	"engines": {
		"node": ">=20"
	},
	"scripts": {
		"test": "playwright test",
		"test:local": "TEST_ENV=local playwright test",
		"test:dev": "TEST_ENV=dev playwright test",
		"test:staging": "TEST_ENV=staging playwright test",
		"test:prod": "TEST_ENV=prod playwright test",
		"test:evidence": "TEST_ENV=dev EVIDENCE=true playwright test",
		"test:headed": "HEADED=true playwright test",
		"test:ui": "playwright test --ui",
		"test:debug": "playwright test --debug",
		"report": "playwright show-report",
		"typecheck": "tsc --noEmit -p tsconfig.json"
	},
	"devDependencies": {
		"@playwright/test": "1.61.1",
		"@types/node": "^20.19.43",
		"dotenv": "^17.3.1",
		"typescript": "^5.8.3"
	}
}
